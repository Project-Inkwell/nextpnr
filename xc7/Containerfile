# The environment the xc7 branch builds and runs in: yosys, what
# nextpnr-himbaechel builds with, Project X-Ray's database of the Artix-7
# that the xilinx uarch's chipdb is generated from, X-Ray's tools that turn
# nextpnr's FASM into a bitstream, and Project Inkwell's xc7 timing database
# that times the chipdb. nextpnr itself is not in it: the checkout is
# mounted at /src and built there (run.sh), so a change needs no new image.
FROM docker.io/library/ubuntu:24.04@sha256:496754492fb28b4d3049432f2ca787449331e23fb14f0dd3fffea86bf5a93eb4

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git ca-certificates pkg-config \
        python3 python3-dev python3-venv python3-pip \
        libboost-filesystem-dev libboost-program-options-dev libboost-thread-dev \
        libboost-iostreams-dev libboost-system-dev libeigen3-dev \
        bison flex gawk libreadline-dev tcl-dev libffi-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# yosys, the release before the newest.
ARG YOSYS_TAG=v0.69
RUN git clone -q --depth 1 --branch ${YOSYS_TAG} --recurse-submodules --shallow-submodules \
        https://github.com/YosysHQ/yosys /tmp/yosys \
    && cd /tmp/yosys && cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local . \
    && cmake --build build -j"$(nproc)" && cmake --install build \
    && rm -rf /tmp/yosys

# prjxray-db's last commit (2021-12-14): its Artix-7 only.
ARG PRJXRAY_DB_COMMIT=0a0addedd73e7e4139d52a6d8db4258763e0f1f3
RUN git clone -q --filter=blob:none --no-checkout https://github.com/f4pga/prjxray-db /opt/prjxray-db \
    && cd /opt/prjxray-db && git sparse-checkout set artix7 && git checkout -q ${PRJXRAY_DB_COMMIT}

# prjxray's tools: fasm2frames and xc7frames2bit, in a venv of their own.
ARG PRJXRAY_COMMIT=c9f02d8576042325425824647ab5555b1bc77833
RUN git clone -q https://github.com/f4pga/prjxray /opt/prjxray && cd /opt/prjxray && git checkout -q ${PRJXRAY_COMMIT} \
    && git submodule update -q --init third_party/abseil-cpp third_party/cctz third_party/googletest \
        third_party/gflags third_party/yaml-cpp third_party/fasm third_party/python-sdf-timing \
        third_party/sanitizers-cmake \
    && mkdir build && cd build && cmake .. && make -j"$(nproc)"
RUN python3 -m venv /opt/prjxray-env \
    && /opt/prjxray-env/bin/pip install -q intervaltree numpy ordered-set parse progressbar2 pyjson5 pyyaml \
        simplejson sympy textx \
    && /opt/prjxray-env/bin/pip install -q -e /opt/prjxray/third_party/fasm -e /opt/prjxray

# Project Inkwell's timing of the 7-series, every speed grade of each device
# it has (github.com/Project-Inkwell/xc7).
ARG XC7_TIMING_COMMIT=d8863f21f8461e253010dec8faa944cc5d566e47
RUN git clone -q https://github.com/Project-Inkwell/xc7 /opt/inkwell-xc7 \
    && cd /opt/inkwell-xc7 && git checkout -q ${XC7_TIMING_COMMIT}

ENV PRJXRAY=/opt/prjxray PRJXRAY_DB=/opt/prjxray-db XC7_TIMING=/opt/inkwell-xc7 PATH=/opt/prjxray-env/bin:$PATH
WORKDIR /src
